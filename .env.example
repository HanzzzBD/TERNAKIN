# Server API (apps/api)
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/ternakin.sqlite
ADMIN_KEY=ganti-dengan-kunci-acak-yang-panjang
SESSION_SECRET=ganti-dengan-rahasia-acak

# Akun nomor WhatsApp + OTP (PRD F5)
# Token perangkat dari md.fonnte.com (menu Device). Kosong + bukan production = mode demo (kode tampil di layar).
FONNTE_TOKEN=
# Lama sesi masuk sebelum harus OTP lagi
SESI_BERLAKU_HARI=30
# Akun demo bersama (Rani = pengguna, Pak Dedi = peternak) untuk juri; isi false saat pilot sungguhan
AKUN_DEMO_AKTIF=true
# Masuk dengan email: Gmail SMTP untuk kode verifikasi & reset sandi.
# Pakai App Password (myaccount.google.com > Keamanan > Sandi aplikasi; wajib 2FA), bukan sandi Gmail biasa.
# Kosong + bukan production = mode demo (kode tampil di layar).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Nama pengirim, mis. Ternakin <alamat@gmail.com>; kosong = memakai SMTP_USER
SMTP_DARI=
# OAuth Client ID tipe Web untuk tombol "Masuk dengan Google"; kosong = tombol disembunyikan
GOOGLE_CLIENT_ID=
# Penyedia LLM: mock (jawaban bawaan) atau gemini.
# Bila gemini tetapi LLM_API_KEY kosong, server tetap jalan memakai mock.
LLM_PROVIDER=mock
# Kunci dari Google AI Studio (aistudio.google.com). Hanya disimpan di server.
LLM_API_KEY=
# Model teks; gemini-3.8-flash lebih kuat tetapi thinking-nya memakan jatah token keluaran
LLM_MODEL=gemini-3.5-flash-lite
LLM_EMBEDDING_MODEL=gemini-embedding-2
LLM_EMBEDDING_DIMENSI=768
# Kosong = bawaan model. Pilihan: minimal, low, medium, high (gemini-3.8-flash tidak mendukung minimal)
LLM_THINKING_LEVEL=
LLM_TIMEOUT_MS=15000
LLM_MAX_OUTPUT_TOKENS=600
# Ambang kemiripan (0-1) agar panduan dianggap relevan untuk Kokok; kalibrasi setelah ada kunci
RAG_AMBANG_KEMIRIPAN=0.6
# Usulan awal; tentukan setelah menghitung token per pemakaian dari prototipe
LLM_DAILY_LIMIT_PER_DEVICE=20
# Usulan awal; perlu disetujui tim bisnis dan lapangan
STALE_DAYS=7
# Folder berisi ternakin.apk untuk tombol "Unduh untuk Android" di website (dipasang dengan
# deploy/pasang-apk.sh). Kosong = <folder database>/unduhan.
UNDUHAN_DIR=

# Web PWA (apps/web/.env)
# Nomor WhatsApp tim (format 628..., dikosongkan sampai ada nomor terverifikasi)
VITE_WA_NUMBER=
