# Server API (apps/api)
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/ternakin.sqlite
ADMIN_KEY=ganti-dengan-kunci-acak-yang-panjang
SESSION_SECRET=ganti-dengan-rahasia-acak
# Penyedia LLM: mock (jawaban bawaan) atau gemini.
# Bila gemini tetapi LLM_API_KEY kosong, server tetap jalan memakai mock.
LLM_PROVIDER=mock
# Kunci dari Google AI Studio (aistudio.google.com). Hanya disimpan di server.
LLM_API_KEY=
# Model teks; gemini-3.8-flash lebih kuat tetapi thinking-nya memakan jatah token keluaran
LLM_MODEL=gemini-3.5-flash-lite
LLM_EMBEDDING_MODEL=gemini-embedding-2
LLM_EMBEDDING_DIMENSI=768
# Kosong = bawaan model. Pilihan: minimal, low, medium, high (gemini-3.8-flash tidak mendukung minimal)
LLM_THINKING_LEVEL=
LLM_TIMEOUT_MS=15000
LLM_MAX_OUTPUT_TOKENS=600
# Ambang kemiripan (0-1) agar panduan dianggap relevan untuk Kokok; kalibrasi setelah ada kunci
RAG_AMBANG_KEMIRIPAN=0.6
# Usulan awal; tentukan setelah menghitung token per pemakaian dari prototipe
LLM_DAILY_LIMIT_PER_DEVICE=20
# Usulan awal; perlu disetujui tim bisnis dan lapangan
STALE_DAYS=7

# Web PWA (apps/web/.env)
# Nomor WhatsApp tim (format 628..., dikosongkan sampai ada nomor terverifikasi)
VITE_WA_NUMBER=
