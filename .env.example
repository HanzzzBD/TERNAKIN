# Server API (apps/api)
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/ternakin.sqlite
ADMIN_KEY=ganti-dengan-kunci-acak-yang-panjang
SESSION_SECRET=ganti-dengan-rahasia-acak
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=600
# Usulan awal; tentukan setelah menghitung token per pemakaian dari prototipe
LLM_DAILY_LIMIT_PER_DEVICE=20
# Usulan awal; perlu disetujui tim bisnis dan lapangan
STALE_DAYS=7

# Web PWA (apps/web/.env)
# Nomor WhatsApp tim (format 628..., dikosongkan sampai ada nomor terverifikasi)
VITE_WA_NUMBER=
